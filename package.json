{
  "name": "whittle",
  "private": true,
  "version": "0.8.0",
  "description": "Whittle — open-source parametric 3D CAD for makers, 3D printing and engineers.",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --config apps/web/vite.config.ts",
    "build": "node node_modules/vite/bin/vite.js build --config apps/web/vite.config.ts",
    "preview": "node node_modules/vite/bin/vite.js preview --config apps/web/vite.config.ts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/features.mjs && node tests/e2e/advanced.mjs && node tests/e2e/modeling.mjs && node tests/e2e/constraints.mjs && node tests/e2e/pictures.mjs && node tests/e2e/shapes.mjs && node tests/e2e/sketching.mjs && node tests/e2e/audit.mjs && node tests/e2e/direct.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@salusoft89/planegcs": "^1.3.0",
    "fflate": "^0.8.2",
    "immer": "^11.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.186.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
