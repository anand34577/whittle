# Whittle server settings. After editing: systemctl restart whittle
# Every option is described in README.md (docs/SELF_HOSTING.md in the source).

# Where to listen. Put a reverse proxy (Caddy, nginx, Traefik) in front for HTTPS.
WHITTLE_BIND=0.0.0.0:8080

# The built web app and the data directory (designs + the default SQLite database).
WHITTLE_WEB=/opt/whittle/web
WHITTLE_DATA=/var/lib/whittle

# Database. Default: SQLite in WHITTLE_DATA (nothing to set up).
# For PostgreSQL:
#WHITTLE_DATABASE_URL=postgres://whittle:CHANGE_ME@localhost:5432/whittle

# Sign-in:  local       username + password (default)
#           oidc        single sign-on only
#           local,oidc  both
#           none        no sign-in: one shared workspace. Trusted home networks only!
WHITTLE_AUTH=local
# Let anyone create an account. The very first account is always allowed and becomes the administrator.
WHITTLE_SIGNUP=false

# Creating that first account asks for this token, so a stranger who reaches a new server first can't claim it.
# Unset: the server makes one up at start-up and writes it to its log (journalctl -u whittle). off: no token.
#WHITTLE_SETUP_TOKEN=

# The address people use, e.g. https://cad.example.com. Required for single sign-on,
# and turns on Secure cookies when it starts with https://
#WHITTLE_PUBLIC_URL=https://cad.example.com

# Single sign-on (OpenID Connect): Authentik, Keycloak, Authelia, Zitadel, Google, Entra ID...
# Redirect URI to register with the provider: <WHITTLE_PUBLIC_URL>/api/auth/oidc/callback
#WHITTLE_OIDC_ISSUER=https://auth.example.com/application/o/whittle/
#WHITTLE_OIDC_CLIENT_ID=whittle
#WHITTLE_OIDC_CLIENT_SECRET=CHANGE_ME
#WHITTLE_OIDC_NAME=Authentik
#WHITTLE_OIDC_AUTO_CREATE=false   # true: anyone who can sign in at the provider gets an account

# Email (SMTP) for invitations, password resets and notices. Administrators can
# also set this in the app (Account → Administration → Sign-in & email), which wins.
# Security: starttls (port 587, default), tls (465), starttls-optional,
#           none = plain, unencrypted SMTP (port 25; trusted networks and local relays only)
#WHITTLE_SMTP_HOST=smtp.example.com
#WHITTLE_SMTP_PORT=587
#WHITTLE_SMTP_SECURITY=starttls
#WHITTLE_SMTP_USERNAME=whittle@example.com
#WHITTLE_SMTP_PASSWORD=CHANGE_ME
#WHITTLE_SMTP_FROM=whittle@example.com
#WHITTLE_SMTP_FROM_NAME=Whittle
# Accept self-signed certificates (internal mail servers)
#WHITTLE_SMTP_ACCEPT_INVALID_CERTS=false

# The in-app AI assistant. People bring their own provider (Claude, OpenAI, a local
# model with Ollama or LM Studio); requests go from their browser to that provider.
# false hides it and keeps the strictest browser security policy.
#WHITTLE_AI=true

# Limits
#WHITTLE_MAX_UPLOAD_MB=64
#WHITTLE_MAX_VERSIONS=50
# Disk space each account may use for its designs, all kept versions included (MB). 0 = no limit.
# Worth setting when WHITTLE_SIGNUP is on, so one account can't fill the disk.
#WHITTLE_USER_QUOTA_MB=2048
#WHITTLE_SESSION_DAYS=30

# Logging (error, warn, info, debug)
RUST_LOG=info,tower_http=warn,sqlx=warn
