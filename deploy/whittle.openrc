#!/sbin/openrc-run
# Whittle for Alpine Linux / OpenRC. Installed by install.sh when systemd is absent.
name="whittle"
description="Whittle (self-hosted parametric CAD)"
command="/opt/whittle/whittle-server"
command_user="whittle:whittle"
command_background=true
pidfile="/run/whittle.pid"
directory="/var/lib/whittle"
output_log="/var/log/whittle.log"
error_log="/var/log/whittle.log"

depend() {
  need net
  after postgresql
}

start_pre() {
  set -a
  . /etc/whittle/whittle.env
  set +a
  checkpath -f -o whittle:whittle /var/log/whittle.log
  # Keep the log from growing without end (audit X-7): past 10 MB the previous one is kept as .1.
  if [ "$(wc -c < /var/log/whittle.log)" -gt 10485760 ]; then
    mv -f /var/log/whittle.log /var/log/whittle.log.1
    checkpath -f -o whittle:whittle /var/log/whittle.log
  fi
}
